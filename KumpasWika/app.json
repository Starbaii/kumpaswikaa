{
  "expo": {
    "name": "KumpasWika",
    "slug": "KumpasWika",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "KumpasWika uses your camera to read your signing.",
        "NSMicrophoneUsageDescription": "KumpasWika uses your microphone to turn spoken replies into text.",
        "NSSpeechRecognitionUsageDescription": "KumpasWika turns spoken replies into text for Deaf users."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kumpaswika.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-sqlite",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "KumpasWika uses your camera to read your signing.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "./node_modules/expo-vision-camera-v4-mediapipe/plugin/index.js",
        {
          "numHands": 2,
          "minDetectionConfidence": 0.5,
          "minPresenceConfidence": 0.5,
          "minTrackingConfidence": 0.5
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "KumpasWika uses your microphone to turn spoken replies into text.",
          "speechRecognitionPermission": "KumpasWika turns spoken replies into text for Deaf users.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c9cdf322-07fa-46ca-ae91-639bf24c2f61"
      }
    }
  }
}
